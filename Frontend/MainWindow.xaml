<Window x:Class="ticketmasterwpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
        Height="650" Width="1050"
        Title="ticketmaster"
        Icon="Resources/Icons/ticketmaster_icon.png"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen">

	<Border CornerRadius="20" ClipToBounds="True">
		<Border.Background>
			<RadialGradientBrush x:Name="MainBackgroundBrush" RadiusX="1.2" RadiusY="1.2" Center="0.5,0.5" GradientOrigin="0.5, 0.2">
				<GradientStop x:Name="BGGradientStop" Color="#20232A" Offset="0"/>
				<GradientStop Color="#0D0E12" Offset="0.4"/>
				<GradientStop Color="#050507" Offset="1"/>
			</RadialGradientBrush>
		</Border.Background>

        <Grid>
            <Border CornerRadius="20" ClipToBounds="True">
                <Grid>
                    <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="Transparent"/>
                </Grid>
            </Border>

            <Grid x:Name="ModalOverlay" Visibility="Collapsed" Panel.ZIndex="1000">
                <Border Background="#CC000000" CornerRadius="20"/>
                <ContentControl x:Name="ModalContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Panel.ZIndex="9000" Background="#CC0D0E12">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="M 0,20 A 20,20 0 1 1 20,40" Stroke="#16C098" StrokeThickness="4" StrokeStartLineCap="Round" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerTransform" Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SpinnerTransform" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock Text="Loading..." Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0" Opacity="0.7"/>
                </StackPanel>
            </Grid>
            <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" Panel.ZIndex="9999"/>
        </Grid>
    </Border>
</Window>