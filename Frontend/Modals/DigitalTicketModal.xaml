<UserControl x:Class="ticketmasterwpf.Modals.DigitalTicketModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="320" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Border x:Name="TicketContainer" Background="#1A1C23" CornerRadius="25" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" x:Name="TopImageContainer" CornerRadius="25,25,0,0">

                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="Black" CornerRadius="25,25,0,0"
                                        Width="{Binding ActualWidth, ElementName=TopImageContainer}"
                                        Height="{Binding ActualHeight, ElementName=TopImageContainer}"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>

                    <Grid>
                        <Image Source="{Binding SelectedMoviePoster}" Stretch="UniformToFill">
                            <Image.Effect>
                                <BlurEffect Radius="15"/>
                            </Image.Effect>
                        </Image>
                        <Border Background="#CC000000"/>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25">

                            <Viewbox MaxHeight="60" Width="250" StretchDirection="DownOnly" Margin="0,0,0,10">
                                <TextBlock Text="{Binding SelectedMovieTitle}" Foreground="White" FontSize="22" FontWeight="Black" TextWrapping="Wrap" TextAlignment="Center"/>
                            </Viewbox>

                            <TextBlock Text="{Binding SelectedShowtime}" Foreground="#16C098" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                            <TextBlock Text="{Binding SelectedRoomName}" Foreground="#88FFFFFF" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                            <TextBlock x:Name="SeatsInfoTxt" Text="{Binding SeatInfo}" Foreground="#E0E0E0" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>

                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Padding="25" Background="#121218" CornerRadius="0,0,25,25">
                    <StackPanel>
                        <TextBlock Text="DIGITAL PASS ACCESS" Foreground="#4DFFFFFF" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <Border Background="White" Padding="10" CornerRadius="12" HorizontalAlignment="Center" Margin="0,0,0,15">
                            <Image Source="{Binding QRCodeImage}" Width="110" Height="110" SnapsToDevicePixels="True"/>
                        </Border>
                        <TextBlock Text="TICKET ID" Foreground="#4DFFFFFF" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TicketId}" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,20"/>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="TOTAL PAID" Foreground="#88FFFFFF" FontSize="11"/>
                                <TextBlock Text="{Binding TotalAmount}" Foreground="#16C098" FontSize="18" FontWeight="Black"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="SAVE / PRINT" Click="PrintTicket_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Width="90" Height="25" Margin="0,10,10,0"/>
                                <Button Content="CLOSE" Click="Close_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" Width="60" Height="25" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>