<UserControl x:Class="ticketmasterwpf.Modals.BookingModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
             Width="400" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <Grid>
        <Border Background="#1A1C23" CornerRadius="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>
        </Border>

        <Border Background="#1A1C23" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="25" Padding="30">
            <StackPanel>
                <TextBlock Text="Checkout" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,0,0,5"/>
                <TextBlock Text="Fill in your details to get your tickets." Foreground="#66FFFFFF" FontSize="11" Margin="0,0,0,25"/>

                <Border Background="#0DFFFFFF" CornerRadius="15" Padding="20" Margin="0,0,0,25">
                    <Grid>
                        <StackPanel Width="230" HorizontalAlignment="Left">
                            <TextBlock Text="ORDER SUMMARY" Foreground="#16C098" FontSize="9" FontWeight="Black"/>
                            
                            <Viewbox MaxHeight="25" HorizontalAlignment="Left" StretchDirection="DownOnly" Margin="0,5,0,0">
                                <TextBlock x:Name="MovieTitleTxt" Text="Movie Title" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            </Viewbox>

                            <Viewbox MaxHeight="20" HorizontalAlignment="Left" StretchDirection="DownOnly" Margin="0,2,0,0">
                                <TextBlock x:Name="SeatsInfoTxt" Text="Seats info" Foreground="#88FFFFFF" FontSize="11"/>
                            </Viewbox>
                        </StackPanel>
                        <TextBlock x:Name="TotalPriceTxt" Text="0 Ft" Foreground="White" FontSize="20" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Margin="0,0,0,30">
                    <TextBlock Text="GUEST DETAILS" Foreground="#16C098" FontSize="9" FontWeight="Black" Margin="0,0,0,15"/>
                    <TextBlock Text="EMAIL" Foreground="#44FFFFFF" FontSize="8" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border Style="{StaticResource InputBorderStyle}" Height="38" Margin="0,0,0,15">
                        <TextBox x:Name="GuestEmailInput" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" FontSize="12.5"/>
                    </Border>
                    <TextBlock Text="PHONE" Foreground="#44FFFFFF" FontSize="8" FontWeight="Bold" Margin="5,0,0,5"/>
                    <Border Style="{StaticResource InputBorderStyle}" Height="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PhonePrefixCombo" Grid.Column="0" Style="{StaticResource CleanComboBox}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0" Padding="8,0">
                                <ComboBoxItem Content="+36 (HU)" Tag="+36" IsSelected="True"/>
                                <ComboBoxItem Content="+43 (AT)" Tag="+43"/>
                                <ComboBoxItem Content="+44 (UK)" Tag="+44"/>
                                <ComboBoxItem Content="+1 (US)" Tag="+1"/>
                            </ComboBox>
                            <TextBox x:Name="PhoneInput" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="-21,0,0,-1" VerticalContentAlignment="Center" FontSize="12.5" MaxLength="15"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="CANCEL" Click="Cancel_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" Margin="0,0,35,0" Height="30" Width="130"/>
                    <Button Grid.Column="1" Content="PAY NOW" Click="Pay_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Margin="35,0,0,0" Height="30" Width="130"/>
                </Grid>
            </StackPanel>
        </Border>
        <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" Panel.ZIndex="5000"/>
    </Grid>
</UserControl>