<UserControl x:Class="ticketmasterwpf.Modals.MovieDetailModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <Storyboard x:Key="OpenModal">
            <DoubleAnimation Storyboard.TargetName="ModalRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseModal">
            <DoubleAnimation Storyboard.TargetName="ModalRoot" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" CornerRadius="5" Background="#44FFFFFF" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#16C098"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyCustomScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="ModalRoot" Visibility="Collapsed">
        <Border Background="#CC000000" MouseDown="CloseModal_Click" CornerRadius="20"/>
        <Border Width="850" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#1A1C23" CornerRadius="25" BorderThickness="0" SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.3" Color="Black"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="LeftColumnBorder" CornerRadius="25,0,0,25">

                    <Border.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="Black" CornerRadius="25,0,0,25" Width="{Binding ActualWidth, ElementName=LeftColumnBorder}" Height="{Binding ActualHeight, ElementName=LeftColumnBorder}"/>
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Border.OpacityMask>

                    <Grid>
                        <Image Source="{Binding PosterUrl}" Stretch="UniformToFill" Opacity="0.3">
                            <Image.Effect>
                                <BlurEffect Radius="40"/>
                            </Image.Effect>
                        </Image>

                        <Border Background="#22000000"/>

                        <Border x:Name="PosterDisplay" CornerRadius="15" Width="240" Height="360" VerticalAlignment="Center" HorizontalAlignment="Center" BorderBrush="#3FFFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.6" Color="Black"/>
                            </Border.Effect>
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding PosterUrl}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="40,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GlowButtonStyle}" Width="25" Height="25" Content="✕" FontSize="15" Click="CloseModal_Click" BorderBrush="#3FFFFFFF"/>

                    <StackPanel Grid.Row="0" Margin="0,0,40,0">
                        <StackPanel Grid.Row="0" Margin="0,0,40,0">
                            <Viewbox MaxHeight="80" HorizontalAlignment="Left" StretchDirection="DownOnly">
                                <TextBlock Text="{Binding Title}" FontSize="32" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Width="450"/>
                            </Viewbox>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="#16C098" CornerRadius="5" Padding="6,2" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ImdbRating, StringFormat='IMDb {0}'}" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                            </Border>
                            <TextBlock Text="🕒" Foreground="#16C098" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Duration}" Foreground="#88FFFFFF" FontSize="13" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <TextBlock Text="🎭" Foreground="#16C098" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Genre}" Foreground="#88FFFFFF" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,25,0,0">
                        <TextBlock Text="SYNOPSIS" FontSize="11" FontWeight="Bold" Foreground="#16C098" FontStretch="Expanded" Opacity="0.8"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Height="120" Margin="0,10,0,0">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource MyCustomScrollBarStyle}"/>
                            </ScrollViewer.Resources>

                            <TextBlock Text="{Binding Description}" Foreground="#CCFFFFFF" FontSize="14" LineHeight="23" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,20,0,25">
                        <TextBlock Text="AVAILABLE SHOWTIMES" FontSize="11" FontWeight="Bold" Foreground="#16C098" FontStretch="Expanded"  Opacity="0.8" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="ShowtimesItemsControl" ItemsSource="{Binding Showtimes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,10,10" Style="{StaticResource GlowButtonStyle}" Width="80" Height="35" Cursor="Hand" Click="Showtime_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoShowtimesMessage" Text="No screenings available for today." Foreground="#44FFFFFF" FontSize="13" FontStyle="Italic" Visibility="Collapsed"/>

                        <StackPanel x:Name="UpcomingMessagePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock Text="Releasing on: " Foreground="#44FFFFFF" FontSize="13" FontStyle="Italic"/>
                            <TextBlock Text="{Binding ReleaseDate, StringFormat='MMMM dd, yyyy'}" Foreground="#16C098" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button x:Name="BtnGetTickets" Width="200" Height="45" Margin="0,0,15,0" Cursor="Hand" Click="GetEarliestTickets_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" Background="#16C098" CornerRadius="12">
                                        <TextBlock Text="GET TICKETS NOW" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#1A1C23" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>