<UserControl x:Class="ticketmasterwpf.Modals.AddMovieModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ticketmasterwpf.Modals"
             xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="600">
    <Grid>
        <Border Background="#CC000000" CornerRadius="20">
        <Border Background="#1A1C23" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="25" Width="550" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="MovieModalTitle" Text="Add New Movie to Database" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Movie Title" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource InputBorderStyle}">
                                <TextBox x:Name="MovieTitleInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White"/>
                            </Border>
                            <Button Grid.Column="1" Click="ImdbSearch_Click" Cursor="Hand" Margin="8,0,0,0" Width="40" Background="#1AFFFFFF" BorderBrush="#3FFFFFFF" Style="{StaticResource GlowButtonStyle}">
                                <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="White" Stretch="Uniform" Width="15" Height="15"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="Duration (minutes)" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,20">
                            <TextBox x:Name="MovieDurationInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White"/>
                        </Border>

                        <TextBlock Text="IMDb Rating" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="MovieRatingInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White" IsReadOnly="True" Opacity="0.7"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Genre" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,20">
                            <TextBox x:Name="MovieGenreInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White"/>
                        </Border>

                        <TextBlock Text="Poster Image Link" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <TextBox x:Name="MoviePosterInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White" Text="https://..."/>
                        </Border>
                        <TextBlock Text="Availability Status" Foreground="#88FFFFFF" Padding="0,3" FontSize="11" FontWeight="SemiBold" Margin="0,15,0,8"/>
                        <Border Style="{StaticResource InputBorderStyle}">
                            <ComboBox x:Name="MovieStatusInput" Style="{StaticResource CleanComboBox}" Foreground="White">
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Upcoming"/>
                                <ComboBoxItem Content="Not Active"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Description" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,20,0,8"/>
                <Border Style="{StaticResource InputBorderStyle}" Height="80">
                    <TextBox x:Name="MovieDescriptionInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="12" Foreground="White" CaretBrush="White" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,35,0,0">
                    <Button Content="Cancel" Click="CloseModal_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" Padding="8,4" FontSize="10" Height="30" Width="70" Margin="0,0,15,0"/>
                    <Button x:Name="SaveMovieBtn" Content="Save Movie" Click="Save_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Padding="8,4" FontSize="10" Height="30" Width="100"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Panel.ZIndex="5000"/>
    </Grid>
</UserControl>