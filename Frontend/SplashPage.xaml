<Page x:Class="ticketmasterwpf.SplashPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SplashPage"
      Background="Transparent"
      Loaded="Page_Loaded">

    <Grid>
        <Canvas x:Name="SpectrumCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
            <Canvas.Effect>
                <DropShadowEffect Color="#00F0FF" BlurRadius="25" ShadowDepth="0" Opacity="0.9"/>
            </Canvas.Effect>
        </Canvas>

        <StackPanel x:Name="LogoPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>

</Page>