<Page x:Class="ticketmasterwpf.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="HomePage"
      Background="Transparent">

    <Page.Resources>
        <Style TargetType="Button" x:Key="ShowtimeBtnStyle">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,0,5,5"/>

            <Setter Property="Padding" Value="15,6"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" 
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D99058"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MainTabs"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <TextBlock Text="{TemplateBinding Content}" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,30,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#88FFFFFF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Storyboard x:Key="PageLoadAnimation">
            <DoubleAnimation Storyboard.TargetName="MainContentGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetName="MainContentTransform" Storyboard.TargetProperty="Y" From="30" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ListRefreshAnimation">
            <DoubleAnimation Storyboard.TargetName="MoviesItemsControl" 
                     Storyboard.TargetProperty="Opacity" 
                     From="0.3" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PageLoadAnimation}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="MainContentGrid" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MainContentTransform" Y="30"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Canvas Panel.ZIndex="2000" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Border x:Name="WelcomeToast" 
                    Background="#D99058" 
                    CornerRadius="20" 
                    Padding="20,10" 
                    Canvas.Top="-60" 
                    Opacity="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Welcome back, " Foreground="White" FontWeight="SemiBold"/>
                    <TextBlock x:Name="UserNameText" Text="User" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="!" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastTransform" Y="0"/>
                </Border.RenderTransform>
            </Border>
        </Canvas>

        <Grid Grid.Row="0" Margin="30,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="HomeTab" Content="HOME" IsChecked="True" Style="{StaticResource NavTabButtonStyle}"/>
                <RadioButton x:Name="SoonTab" Content="COMING SOON" Style="{StaticResource NavTabButtonStyle}"/>

                <RadioButton x:Name="TicketsTab" Content="MY TICKETS" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}"/>
                <RadioButton x:Name="ProfileTab" Content="PROFILE" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}"/>
                <RadioButton x:Name="CashierTab" Content="CASHIER DESK" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}"/>
                <RadioButton x:Name="AdminTab" Content="MANAGEMENT" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LoginBtn" Content="LOGIN / REGISTER" Click="Login_Click" Cursor="Hand" Background="Transparent" Foreground="White" BorderThickness="1.5" BorderBrush="#D99058" Padding="15,6" FontSize="10" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="LogoutBtn" Content="LOGOUT" Click="Logout_Click" Cursor="Hand" Visibility="Collapsed" Background="Transparent" Foreground="#FF5555" BorderThickness="1.5" BorderBrush="#FF5555" Padding="15,6" FontSize="10" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="30,5" Height="180" CornerRadius="20"> <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                    <GradientStop Color="{Binding FeaturedMovie.PlaceholderColor}" Offset="0"/>
                    <GradientStop Color="#050507" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        <Grid Margin="30,0"> <StackPanel VerticalAlignment="Center">
            <Border Background="#FF9800" CornerRadius="5" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,8">
                <TextBlock Text="FEATURED MOVIE" Foreground="Black" FontSize="8.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="{Binding FeaturedMovie.Title}" Foreground="White" FontSize="26.5" FontWeight="ExtraBold"/>
                    <TextBlock Text="Watch the latest cinematic masterpiece now." Foreground="#AAFFFFFF" FontSize="11" Margin="0,3,0,15"/>
                    <Button Content="GET TICKETS BELOW" Style="{StaticResource ShowtimeBtnStyle}" HorizontalAlignment="Left" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="30,12,30,5" MinHeight="42">

            <Grid Visibility="{Binding IsChecked, ElementName=HomeTab, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="NOW SHOWING" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>

                <Border HorizontalAlignment="Right" Background="#1AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="4,2">
                    <ItemsControl ItemsSource="{Binding AvailableDates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="DateSelector" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="DateBtn_Click" Margin="1,0" Cursor="Hand">
                                    <RadioButton.Template>
                                        <ControlTemplate TargetType="RadioButton">
                                            <Border x:Name="DateBorder" CornerRadius="10" Background="Transparent" Padding="7,4" MinWidth="55">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DayName}" Foreground="#66A0A5B5" FontSize="7.5" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DateNumber}" Foreground="#A0A5B5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="DateBorder" Property="Background" Value="#1AFFFFFF"/>
                                                    <Setter Property="Foreground" Value="#03DAC6"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RadioButton.Template>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <Grid Visibility="{Binding IsChecked, ElementName=SoonTab, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="UPCOMING RELEASES" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="MoviesScrollViewer" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" PanningMode="HorizontalOnly" PreviewMouseWheel="MoviesScrollViewer_PreviewMouseWheel">
                <ItemsControl x:Name="MoviesItemsControl" ItemsSource="{Binding Movies}" Margin="20,0,20,20" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Width="173" Height="260" Margin="15" CornerRadius="15" Cursor="Hand" BorderBrush="#3FFFFFFF" BorderThickness="1" MouseEnter="MovieCard_MouseEnter" MouseLeave="MovieCard_MouseLeave">
                                <Border.Effect>
                                    <DropShadowEffect Color="{Binding PlaceholderColor}" BlurRadius="35" Opacity="0.5" ShadowDepth="0"/>
                                </Border.Effect>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="{Binding PlaceholderColor}" Offset="0"/>
                                        <GradientStop Color="#44000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                
                                <Grid>
                                    <StackPanel VerticalAlignment="Bottom" Margin="15" x:Name="BaseInfo">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.9"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock Text="★ 8.9  •  Movie" Foreground="#CCFFFFFF" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="HoverOverlay" Background="#00050505" Opacity="0" CornerRadius="15">
                                        <StackPanel VerticalAlignment="Bottom" Margin="20">
                                            <TextBlock Text="{Binding Title}" Foreground="White" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Genre}" Foreground="#88A0A5B5" FontSize="9" Margin="0,5,0,15"/>
                                            <TextBlock Text="SHOWTIMES" Foreground="#66FFFFFF" FontSize="9" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding Showtimes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding}" Style="{StaticResource ShowtimeBtnStyle}" Click="Showtime_Click"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="BaseInfo" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                <DoubleAnimation Storyboard.TargetName="BaseInfo" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Button Width="40" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="Hand" Click="ScrollLeft_Click" Opacity="0.15">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path Data="M 25,10 L 10,25 L 25,40" Stroke="White" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Width="40" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="Hand" Click="ScrollRight_Click" Opacity="0.15">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path Data="M 10,10 L 25,25 L 10,40" Stroke="White" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Border x:Name="ErrorToast" Background="#2D2D30" CornerRadius="12" 
            Opacity="0" Visibility="Collapsed" HorizontalAlignment="Center"
            Padding="15,5,15,5" BorderThickness="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <Ellipse x:Name="ErrorIconBack" Fill="IndianRed" Visibility="Visible"/>
                            <TextBlock x:Name="ErrorIconText" Text="!" Foreground="White" FontSize="9pt" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>

                            <Ellipse x:Name="SuccessIconBack" Fill="MediumSeaGreen" Visibility="Collapsed"/>
                            <TextBlock x:Name="SuccessIconText" Text="✓" Foreground="White" FontSize="10pt" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock x:Name="ErrorText" Foreground="White" FontSize="9pt" 
                   VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>

                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-15,-5">
                        <Path x:Name="BgPathLeft" Stroke="#22CD5C5C" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="BgPathRight" Stroke="#22CD5C5C" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="LeftTimerStroke" Stroke="IndianRed" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="RightTimerStroke" Stroke="IndianRed" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>