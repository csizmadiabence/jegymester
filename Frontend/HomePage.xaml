												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
								<TextBlock Grid.Row="2" Text="Active tickets" Foreground="#22FFFFFF" FontSize="9" HorizontalAlignment="Center" Margin="0,15,0,0"/>
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</Grid>
			<Grid Grid.RowSpan="4" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Panel.ZIndex="2000">
				<Border x:Name="ErrorToast" Background="#2D2D30" CornerRadius="12" Opacity="0" Visibility="Collapsed" Padding="15,5" BorderThickness="0">
					<Border.Effect>
						<DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
					</Border.Effect>
					<Grid>
						<StackPanel Orientation="Horizontal">
							<Grid Width="16" Height="16" Margin="0,0,8,0">
								<Ellipse x:Name="ErrorIconBack" Fill="IndianRed"/>
								<TextBlock x:Name="ErrorIconText" Text="!" Foreground="White" FontSize="9pt" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								<Ellipse x:Name="SuccessIconBack" Fill="MediumSeaGreen" Visibility="Collapsed"/>
								<TextBlock x:Name="SuccessIconText" Text="✓" Foreground="White" FontSize="10pt" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
							</Grid>
							<TextBlock x:Name="ErrorText" Foreground="White" FontSize="9pt" VerticalAlignment="Center" TextWrapping="NoWrap"/>
						</StackPanel>
						<Canvas Margin="-15,-5">
							<Path x:Name="BgPathLeft" Stroke="#22CD5C5C" StrokeThickness="1" StrokeLineJoin="Round"/>
							<Path x:Name="BgPathRight" Stroke="#22CD5C5C" StrokeThickness="1" StrokeLineJoin="Round"/>
							<Path x:Name="LeftTimerStroke" Stroke="IndianRed" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
							<Path x:Name="RightTimerStroke" Stroke="IndianRed" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
						</Canvas>
					</Grid>
				</Border>
			</Grid>
		</Grid>
		<Grid x:Name="AddMovieModal" Visibility="Collapsed" Panel.ZIndex="2000">
			<Border Background="#CC000000" CornerRadius="20">

				<Border Background="#1A1C23" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="25" Width="550" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
					<StackPanel>
						<TextBlock x:Name="MovieModalTitle" Text="Add New Movie to Database" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="25"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Movie Title" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,20">
									<TextBox x:Name="MovieTitleInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White"/>
								</Border>

								<TextBlock Text="Duration (minutes)" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}">
									<TextBox x:Name="MovieDurationInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White"/>
								</Border>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Genre" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,20">
									<ComboBox x:Name="MovieGenreInput" Style="{StaticResource CleanComboBox}" Padding="13,5" FontSize="13">
										<ComboBoxItem Content="Action / Sci-Fi" Foreground="White"/>
										<ComboBoxItem Content="Drama / Biography" Foreground="White"/>
										<ComboBoxItem Content="Animation / Family" Foreground="White"/>
										<ComboBoxItem Content="Comedy" Foreground="White"/>
									</ComboBox>
								</Border>

								<TextBlock Text="Poster Image Link" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}">
									<TextBox x:Name="MoviePosterInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White" Text="https://..."/>
								</Border>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,35,0,0">
							<Button Content="Cancel" Click="CloseModal_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" Padding="8,4" FontSize="10" Height="30" Width="70" Margin="0,0,15,0"/>
							<Button x:Name="SaveMovieBtn" Content="Save Movie" Click="Save_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Padding="8,4" FontSize="10" Height="30" Width="100"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Border>
		</Grid>
		<Grid x:Name="AddScreeningModal" Visibility="Collapsed" Panel.ZIndex="2000">
			<Border Background="#CC000000" CornerRadius="20" Margin="10">
				<Border Background="#1A1C23" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="25" Width="550" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
					<StackPanel>
						<TextBlock Text="Schedule New Screening" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,25"/>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="25"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Select Movie" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,15">
									<ComboBox x:Name="ScreeningMovieCombo" ItemsSource="{Binding Movies}" DisplayMemberPath="Title" Style="{StaticResource CleanComboBox}" Padding="13,5"/>
								</Border>

								<TextBlock Text="Cinema Room" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}">
									<ComboBox x:Name="ScreeningRoomCombo" Style="{StaticResource CleanComboBox}" Padding="13,5">
										<ComboBoxItem Content="Room 1" Foreground="White"/>
										<ComboBoxItem Content="Room 2" Foreground="White"/>
										<ComboBoxItem Content="Room 3 (IMAX)" Foreground="White"/>
									</ComboBox>
								</Border>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<TextBlock Text="Date" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,15" Padding="5">
									<DatePicker x:Name="ScreeningDatePicker" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center"/>
								</Border>

								<TextBlock Text="Start Time (e.g. 19:30)" Foreground="#88FFFFFF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
								<Border Style="{StaticResource InputBorderStyle}">
									<TextBox x:Name="ScreeningTimeInput" BorderThickness="0" Background="Transparent" Padding="13,8" FontSize="13" Foreground="White" CaretBrush="White" Text="18:00"/>
								</Border>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,30,0,0">
							<Button Content="Cancel" Click="CloseScreeningModal_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" Padding="8,4" FontSize="10" Height="30" Width="70" Margin="0,0,15,0"/>
							<Button Content="Create Session" Click="SaveScreening_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Padding="8,4" FontSize="10" Height="30" Width="100"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Border>
		</Grid>
		<Grid x:Name="DeleteConfirmModal" Visibility="Collapsed" Panel.ZIndex="3000">
			<Border Background="#CC000000" CornerRadius="20" Margin="10">
				<Border Background="#1A1C23" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="20" Width="400" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="⚠️" FontSize="30" Foreground="#FF5555" HorizontalAlignment="Center" Margin="0,0,0,15"/>

						<TextBlock Text="Confirm Deletion" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

						<TextBlock x:Name="DeleteMessageText" Text="Are you sure you want to delete this item?" Foreground="#88FFFFFF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,25"/>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Button Content="Cancel" Click="CloseDeleteModal_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="LightGray" Padding="8,4" FontSize="10" Height="30" Width="80" Margin="0,0,15,0"/>

							<Button Content="Delete" Click="ConfirmDelete_Click" Cursor="Hand" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" Padding="8,4" FontSize="10" Height="30" Width="80"/>
						</StackPanel>
					</StackPanel>
				</Border>
			</Border>
		</Grid>
	</Grid>
</Page>