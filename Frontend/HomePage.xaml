<Page x:Class="ticketmasterwpf.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
      xmlns:modals="clr-namespace:ticketmasterwpf.Modals"
      xmlns:views="clr-namespace:ticketmasterwpf.Views"
      Title="HomePage"
      Background="Transparent">

    <Page.Resources>
        <Storyboard x:Key="PageLoadAnimation">
            <DoubleAnimation Storyboard.TargetName="MainContentGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
            <DoubleAnimation Storyboard.TargetName="MainContentTransform" Storyboard.TargetProperty="Y" From="30" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
		<EventTrigger RoutedEvent="Page.Loaded">
			<BeginStoryboard Storyboard="{StaticResource PageLoadAnimation}"/>
		</EventTrigger>
	</Page.Triggers>
	<Grid x:Name="RootGrid">
        <Grid x:Name="MainContentGrid" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="MainContentTransform" Y="30"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Canvas Panel.ZIndex="2000" VerticalAlignment="Top" HorizontalAlignment="Center">
                <Border x:Name="WelcomeToast" Background="#D99058" CornerRadius="20" Padding="20,10" Canvas.Top="-60" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Welcome back, " Foreground="White" FontWeight="SemiBold"/>
                        <TextBlock x:Name="UserNameText" Text="User" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="!" Foreground="White" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ToastTransform" Y="0"/>
                    </Border.RenderTransform>
                </Border>
            </Canvas>

            <Grid Grid.Row="0" Margin="30,0" Panel.ZIndex="1000">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="HomeTab" Content="HOME" IsChecked="True" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="SoonTab" Content="COMING SOON" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="ProfileTab" Content="PROFILE" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="CashierTab" Content="CASHIER DESK" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked"/>
                    <RadioButton x:Name="AdminTab" Content="MANAGEMENT" Visibility="Collapsed" Style="{StaticResource NavTabButtonStyle}" Checked="Tab_Checked"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Button x:Name="LoginBtn" Content="LOGIN / REGISTER" Click="Login_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" FontSize="10" Height="25" Width="100" Margin="0, 0, 0, -4"/>

                    <StackPanel x:Name="LoggedInPanel" Orientation="Horizontal" Visibility="Hidden" Margin="0,0,0,-4">

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0" Cursor="Hand">
                            <Border Width="12" Height="12" Background="#16C098" Margin="0,0,6,0" Cursor="Arrow">
                                <Border.OpacityMask>
                                    <ImageBrush ImageSource="Resources/Icons/user_icon.png" Stretch="Uniform"/>
                                </Border.OpacityMask>
                            </Border>
                            <TextBlock x:Name="TopUserNameTxt" Text="Admin" Foreground="White" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Cursor="Arrow"/>
                        </StackPanel>

                        <Button x:Name="LogoutBtn" Click="Logout_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FF5555" Width="55" Height="24" Padding="12,0">
                            <TextBlock Text="LOGOUT" Foreground="White" FontWeight="Bold" FontSize="9" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Button>

                    </StackPanel>

                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="30,5" Height="180" CornerRadius="20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=AdminTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ProfileTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CashierTab}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                        <GradientStop Color="{Binding FeaturedMovie.PlaceholderColor}" Offset="0"/>
                        <GradientStop Color="#050507" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="30,0">
                    <StackPanel VerticalAlignment="Center">
                        <Border Background="#FF9800" CornerRadius="5" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,8">
                            <TextBlock Text="FEATURED MOVIE" Foreground="Black" FontSize="8.5" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding FeaturedMovie.Title}" Foreground="White" FontSize="26.5" FontWeight="ExtraBold"/>
                        <TextBlock Text="Watch the latest cinematic masterpiece now." Foreground="#AAFFFFFF" FontSize="11" Margin="0,3,0,15"/>
                        <Button Content="GET TICKETS BELOW" Style="{StaticResource ShowtimeBtnStyle}" HorizontalAlignment="Left" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Margin="20,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#22FFFFFF" Offset="0.05"/>
                        <GradientStop Color="#22FFFFFF" Offset="0.95"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <views:AdminView x:Name="AdminPanel"
                 Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="500" 
                 Visibility="{Binding IsChecked, ElementName=AdminTab, Converter={StaticResource BoolToVis}}" 
                 Movies="{Binding PagedAdminMovies}"
                 PageNumbers="{Binding PageNumbers}"
                 PaginationStatus="{Binding PaginationStatus}"
                 SearchChanged="AdminPanel_SearchChanged"
                 SortChanged="AdminPanel_SortChanged"
                 AddMovieRequested="AdminPanel_AddMovieRequested"
                 EditMovieRequested="AdminPanel_EditMovieRequested"
                 DeleteMovieRequested="AdminPanel_DeleteMovieRequested"
                 AddScreeningRequested="AdminPanel_AddScreeningRequested"
                 PrevPageRequested="AdminPanel_PrevPageRequested"
                 NextPageRequested="AdminPanel_NextPageRequested"
                 PageNumberRequested="AdminPanel_PageNumberRequested" />
            <views:ProfileView Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="900" Visibility="{Binding IsChecked, ElementName=ProfileTab, Converter={StaticResource BoolToVis}}" />
            <views:CashierView x:Name="CashierPanel" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="800" Visibility="{Binding IsChecked, ElementName=CashierTab, Converter={StaticResource BoolToVis}}" VerifyTicketRequested="CashierPanel_VerifyTicketRequested" IssueAllTicketsRequested="CashierPanel_IssueAllTicketsRequested" />
            <views:MovieCatalogView x:Name="MovieCatalog" Grid.Row="2" Grid.RowSpan="2" Margin="0,0,0,5" MovieDetailRequested="MovieCatalog_MovieDetailRequested"/>
        </Grid>
        <modals:AddMovieModal x:Name="AddMoviePopup" Visibility="Collapsed" Panel.ZIndex="2000" Grid.RowSpan="4" MovieSaved="AddMoviePopup_RefreshRequested"/>
        <modals:AddScreeningModal x:Name="AddScreeningPopup" Visibility="Collapsed" Panel.ZIndex="2000" Grid.RowSpan="4"/>
        <modals:DeleteConfirmModal x:Name="DeletePopup" Visibility="Collapsed" Panel.ZIndex="3000" Grid.RowSpan="4" OnDeleteConfirmed="DeletePopup_OnDeleteConfirmed"/>
        <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Panel.ZIndex="5000"/>
        <modals:MovieDetailModal x:Name="MovieDetailPopup" Visibility="Collapsed" Panel.ZIndex="4000" Grid.RowSpan="4"/>
    </Grid>
</Page>