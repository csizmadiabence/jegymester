<Page x:Class="ticketmasterwpf.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
      Title="CheckoutPage" Background="Transparent"
      UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Page.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true" Orientation="Vertical">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#33FFFFFF" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="CheckoutEntrance">
            <DoubleAnimation Storyboard.TargetName="MainContent" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource CheckoutEntrance}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid x:Name="RootGrid">
        <Grid x:Name="MainContent" Margin="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0" 
        Background="#121218" CornerRadius="20" BorderBrush="#1AFFFFFF" BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.4" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="340"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" x:Name="PosterContainer" CornerRadius="19,19,0,0">
                        <Border.OpacityMask>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Border Background="Black" CornerRadius="19,19,0,0"
                                Width="{Binding ActualWidth, ElementName=PosterContainer}"
                                Height="{Binding ActualHeight, ElementName=PosterContainer}"/>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Border.OpacityMask>

                        <Grid>
                            <Image Source="{Binding SelectedMoviePoster}" Stretch="UniformToFill"/>

                            <Border VerticalAlignment="Bottom" Height="100">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00121218" Offset="0"/>
                                        <GradientStop Color="#FF121218" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20,5,20,25">
                        <Viewbox MaxHeight="52" HorizontalAlignment="Left" Stretch="Uniform" StretchDirection="DownOnly" Margin="0,0,0,12">
                            <TextBlock Text="{Binding SelectedMovieTitle}" Foreground="White" FontSize="20" FontWeight="Black" TextWrapping="Wrap" Width="240" LineHeight="26" TextAlignment="Left"/>
                        </Viewbox>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Background="#1A16C098" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedDuration}" Foreground="#16C098" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Border BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="Sci-Fi, Adventure" Foreground="#AAFFFFFF" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <Border Background="#0A0A0C" CornerRadius="12" Padding="15" BorderBrush="#1AFFFFFF" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="📍" Foreground="#16C098" Margin="0,0,10,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedRoomName}" Foreground="#E0E0E0" FontSize="13" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>

                                <Border Height="1" Background="#1AFFFFFF" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📅" Foreground="#16C098" Margin="0,0,10,0" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedShowtime}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Select Ticket Types" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0">
                    <ItemsControl ItemsSource="{Binding SelectedSeatsList}" Margin="0,0,12,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121218" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Margin="0,0,0,6" Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="TICKET TYPE" Foreground="#444" FontSize="8" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Border Background="#1A16C098" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="{Binding SeatInfo}" Foreground="#16C098" FontSize="9" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                            <Border Style="{StaticResource InputBorderStyle}" BorderBrush="#33FFFFFF" Width="170" HorizontalAlignment="Left">
                                                <ComboBox Style="{StaticResource CleanComboBox}" 
                                                          SelectionChanged="TicketType_SelectionChanged" 
                                                          Tag="{Binding}" 
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="Fullprice" Tag="1.0"/>
                                                    <ComboBoxItem Content="Student (-20%)" Tag="0.8"/>
                                                    <ComboBoxItem Content="Senior (-30%)" Tag="0.7"/>
                                                </ComboBox>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                            <TextBlock Text="PRICE" Foreground="#444" FontSize="8" FontWeight="Bold" TextAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} Ft'}" Foreground="White" FontSize="18" FontWeight="Black" TextAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <Separator Background="#22FFFFFF" Margin="0,0,0,10"/>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Total amount" Foreground="#88FFFFFF" FontSize="12"/>
                            <TextBlock Text="Includes booking fee" Foreground="#44FFFFFF" FontSize="9"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalAmount}" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Margin="0,15,0,0">
                        <Button Content="Back" Click="Back_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#CCFF5555" Width="80" HorizontalAlignment="Left"/>
                        <Button Content="Proceed to Payment" Click="ProceedToPayment_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Width="160" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

        <Border x:Name="SuccessOverlay" Visibility="Collapsed" Panel.ZIndex="6000" Background="#E60D0D12" CornerRadius="25" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" Opacity="0.8"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="#1A16C098" CornerRadius="40" Margin="0,0,0,25">
                        <TextBlock Text="✓" Foreground="#16C098" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    </Border>

                    <TextBlock Text="Purchase successful!" Foreground="White" FontSize="28" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="Enjoy the movie." Foreground="#88FFFFFF" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,35"/>

                    <Button Content="VIEW DIGITAL TICKET" Click="ViewTicket_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Width="220" Height="42" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0" Panel.ZIndex="8000"/>
    </Grid>
</Page>