<UserControl x:Class="ticketmasterwpf.Views.AdminView"
             x:Name="adminRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ticketmasterwpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="AdminDashboard" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="500">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="60" Background="#0A0A0C" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="20" Margin="25,30,-5,0" VerticalAlignment="Top" Padding="0,15,0,0">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                <RadioButton x:Name="SubDashboard"
             Tag="/Resources/Icons/home_icon.png"
             ToolTip="Dashboard"
             IsChecked="True"
             Style="{StaticResource CustomImageIconTabStyle}"/>

                <RadioButton x:Name="SubMovies"
             Tag="/Resources/Icons/movie_icon.png"
             ToolTip="Movies"
             Style="{StaticResource CustomImageIconTabStyle}"/>

                <RadioButton x:Name="SubScreenings"
             Tag="/Resources/Icons/calendar_icon.png"
             ToolTip="Screenings"
             Style="{StaticResource CustomImageIconTabStyle}"/>

                <RadioButton x:Name="SubTickets"
             Tag="/Resources/Icons/ticket_icon.png"
             ToolTip="Tickets"
             Style="{StaticResource CustomImageIconTabStyle}"/>

                <RadioButton x:Name="SubCustomers"
             Tag="/Resources/Icons/users_icon.png"
             ToolTip="Customers"
             Style="{StaticResource CustomImageIconTabStyle}"/>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1">

            <Border Visibility="{Binding IsChecked, ElementName=SubDashboard, Converter={StaticResource BoolToVis}}" Margin="30">
                <StackPanel>
                    <UniformGrid Columns="4" Height="110" Margin="0,0,0,30">

                        <Border Margin="0,0,10,0" CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFB75E" Offset="0"/>
                                    <GradientStop Color="#ED8F03" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="20,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Total Movies" Foreground="#CCFFFFFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Movies.Count, ElementName=adminRoot}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <Border Width="45" Height="45" Background="#22FFFFFF" CornerRadius="22.5" HorizontalAlignment="Right">
                                    <TextBlock Text="🎬" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="5,0" CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#42E695" Offset="0"/>
                                    <GradientStop Color="#3BB2B8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="20,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Sessions" Foreground="#CCFFFFFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Screenings.Count, ElementName=adminRoot}" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <Border Width="45" Height="45" Background="#22FFFFFF" CornerRadius="22.5" HorizontalAlignment="Right">
                                    <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="5,0" CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#C56CD6" Offset="0"/>
                                    <GradientStop Color="#3425AF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="20,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Total Revenue" Foreground="#CCFFFFFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="TODO" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <Border Width="45" Height="45" Background="#22FFFFFF" CornerRadius="22.5" HorizontalAlignment="Right">
                                    <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Margin="10,0,0,0" CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2193b0" Offset="0"/>
                                    <GradientStop Color="#6dd5ed" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="20,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Active Users" Foreground="#CCFFFFFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="TODO" Foreground="White" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <Border Width="45" Height="45" Background="#22FFFFFF" CornerRadius="22.5" HorizontalAlignment="Right">
                                    <TextBlock Text="👥" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <Border Background="#0DFFFFFF" CornerRadius="20" Height="260" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <TextBlock Text="TODO" Foreground="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding IsChecked, ElementName=SubMovies, Converter={StaticResource BoolToVis}}" Background="#0DFFFFFF" CornerRadius="20" Margin="30" Padding="25" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Movie Inventory" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Manage active cinema database" Foreground="#16C098" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#111" CornerRadius="8" Padding="10,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SearchInput" TextChanged="SearchInput_TextChanged" Width="140" BorderThickness="0" Background="Transparent" Foreground="White" VerticalAlignment="Center" FontSize="11" CaretBrush="White" Text="Search movie..."/>
                                </StackPanel>
                            </Border>

                            <Border Background="#111" CornerRadius="8" Padding="8,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sort by:" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>
                                    <ComboBox x:Name="SortCombo" SelectionChanged="SortCombo_SelectionChanged" Style="{StaticResource CleanComboBox}" Width="90" FontSize="11" FontWeight="DemiBold" Margin="0,-2,0,0">
                                        <ComboBoxItem Content="Newest" Tag="NEWEST" Foreground="White"/>
                                        <ComboBoxItem Content="Latest" Tag="ID_ASC" Foreground="White" IsSelected="True"/>
                                        <ComboBoxItem Content="Status" Tag="STATUS" Foreground="White"/>
                                        <ComboBoxItem Content="Title (A-Z)" Tag="TITLE_ASC" Foreground="White"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Button x:Name="AddMovie" Content="+ Add" Click="OpenAddMovie_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Padding="8,4" FontSize="10" Height="30" Width="45"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                            <Grid Margin="15,0" TextElement.Foreground="#44FFFFFF" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ID" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Movie Title" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="Genre" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="Duration" HorizontalAlignment="Left" Margin="-15,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="Status" HorizontalAlignment="Left" Margin="0,0,23,0"/>
                                <TextBlock Grid.Column="5" Text="Manage" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Movies, ElementName=adminRoot}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="AdminMovieSelection" Cursor="Hand">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="RowBorder" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="15,10" Background="Transparent">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="110"/>
                                                                <ColumnDefinition Width="85"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Id}" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Genre}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Duration}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <Border Grid.Column="4" CornerRadius="6" VerticalAlignment="Center" Padding="8,2" Margin="0,0,10,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                                <Setter Property="Background" Value="#1A00B087"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                                                <Setter Property="Background" Value="#1A4FACFE"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="Not Active">
                                                                                <Setter Property="Background" Value="#1AFF5555"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#AAFFFFFF"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                                    <Setter Property="Foreground" Value="#16C098"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Upcoming">
                                                                                    <Setter Property="Foreground" Value="#4FACFE"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Status}" Value="Not Active">
                                                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Click="EditMovie_Click" Width="14" Height="14" Margin="0,0,6,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#4FACFE">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/edit_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#75bfff"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Click="DeleteMovie_Click" Width="14" Height="14" Margin="0,0,3,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#FF5555">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/delete_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#FF8888"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#0FFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding MoviePaginationStatus, ElementName=adminRoot}" Foreground="#44FFFFFF" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&lt;" Style="{StaticResource PagingBtnStyle}" Click="PrevPage_Click"/>

                            <ItemsControl ItemsSource="{Binding MoviePageNumbers, ElementName=adminRoot}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Number}" GroupName="AdminMoviePages" Style="{StaticResource PagingNumStyle}" IsChecked="{Binding IsActive, Mode=TwoWay}" Click="PageNumber_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="&gt;" Style="{StaticResource PagingBtnStyle}" Click="NextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Visibility="{Binding IsChecked, ElementName=SubScreenings, Converter={StaticResource BoolToVis}}" Background="#0DFFFFFF" CornerRadius="20" Margin="30" Padding="25" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Active Screenings" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Manage active showtimes and ticket prices" Foreground="#16C098" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#111" CornerRadius="8" Padding="10,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SearchScreeningInput" TextChanged="SearchScreeningInput_TextChanged" Width="140" BorderThickness="0" Background="Transparent" Foreground="White" VerticalAlignment="Center" FontSize="11" CaretBrush="White" Tag="Search by movie title..." Text="Search by movie title..."/>
                                </StackPanel>
                            </Border>

                            <Border Background="#111" CornerRadius="8" Padding="8,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sort by:" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>
                                    <ComboBox x:Name="SortScreeningCombo" SelectionChanged="SortScreeningCombo_SelectionChanged" Style="{StaticResource CleanComboBox}" Width="90" FontSize="11" FontWeight="DemiBold" Margin="0,-2,0,0">
                                        <ComboBoxItem Content="Date" Foreground="White" IsSelected="True"/>
                                        <ComboBoxItem Content="Movie A-Z" Foreground="White"/>
                                        <ComboBoxItem Content="Price" Foreground="White"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Button Content="+ Add" Click="OpenAddScreening_Click" Style="{StaticResource GlowButtonStyle}" 
                        BorderBrush="#16C098" Padding="8,4" FontSize="10" Height="30" Width="45"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                            <Grid Margin="15,0" TextElement.Foreground="#44FFFFFF" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ID" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Movie Title" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="Room" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="Start Time" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="4" Text="Price" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="5" Text="Manage" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Screenings, ElementName=adminRoot}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="AdminScreeningSelection" Cursor="Hand">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="RowBorder" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="15,10" Background="Transparent">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="85"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Id}" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1" Text="{Binding Movie.Title}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2" Text="{Binding RoomName}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="3" Text="{Binding StartTime, StringFormat='yyyy.MM.dd HH:mm'}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="4" Text="{Binding Price, StringFormat='{}{0} Ft'}" Foreground="#16C098" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>

                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Click="EditScreening_Click" Width="14" Height="14" Margin="0,0,6,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#4FACFE">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/edit_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#75bfff"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Click="DeleteScreening_Click" Width="14" Height="14" Margin="0,0,3,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#FF5555">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/delete_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#FF8888"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#0FFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ScreeningPaginationStatus, ElementName=adminRoot}" Foreground="#44FFFFFF" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&lt;" Style="{StaticResource PagingBtnStyle}" Click="PrevPage_Click"/>

                            <ItemsControl ItemsSource="{Binding ScreeningPageNumbers, ElementName=adminRoot}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Number}" GroupName="AdminScreeningPages" Style="{StaticResource PagingNumStyle}" IsChecked="{Binding IsActive, Mode=TwoWay}" Click="PageNumber_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="&gt;" Style="{StaticResource PagingBtnStyle}" Click="NextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Visibility="{Binding IsChecked, ElementName=SubCustomers, Converter={StaticResource BoolToVis}}" Background="#0DFFFFFF" CornerRadius="20" Margin="30" Padding="25" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Customer Management" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Manage registered users and accounts" Foreground="#16C098" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#111" CornerRadius="8" Padding="10,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBox Width="140" BorderThickness="0" Background="Transparent" Foreground="White" VerticalAlignment="Center" FontSize="11" CaretBrush="White" Text="Search user..."/>
                                </StackPanel>
                            </Border>

                            <Border Background="#111" CornerRadius="8" Padding="8,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sort by:" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="11" Margin="0,0,3,0"/>
                                    <ComboBox Style="{StaticResource CleanComboBox}" Width="70" FontSize="11" FontWeight="DemiBold" Margin="0,-2,0,0">
                                        <ComboBoxItem Content="Newest" IsSelected="True" Foreground="White"/>
                                        <ComboBoxItem Content="A-Z" Foreground="White"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Button Content="+ Add" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" Padding="8,4" FontSize="10" Height="30" Width="45"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                            <Grid Margin="15,0" TextElement.Foreground="#44FFFFFF" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ID" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Full Name" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="Email Address" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="Phone" HorizontalAlignment="Left" Margin="-15,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="Role" HorizontalAlignment="Left" Margin="0,0,23,0"/>
                                <TextBlock Grid.Column="5" Text="Manage" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Customers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="AdminCustomerSelection" Cursor="Hand">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="RowBorder" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="15,10" Background="Transparent">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="2.5*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="85"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Id}" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding FullName}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Email}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="3" Text="{Binding Phone}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <Border Grid.Column="4" CornerRadius="6" VerticalAlignment="Center" Padding="8,2" Margin="0,0,15,0" HorizontalAlignment="Left">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#1A4FACFE"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                                <Setter Property="Background" Value="#1AFF5555"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Role}" Value="Cashier">
                                                                                <Setter Property="Background" Value="#1AE0A96D"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Role}" Value="User">
                                                                                <Setter Property="Background" Value="#1AE0A96D"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <TextBlock Text="{Binding Role}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#4FACFE"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                                    <Setter Property="Foreground" Value="#FF5555"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Role}" Value="Cashier">
                                                                                    <Setter Property="Foreground" Value="#E0A96D"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Role}" Value="User">
                                                                                    <Setter Property="Foreground" Value="SkyBlue"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Width="14" Height="14" Margin="0,0,6,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#4FACFE">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/edit_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#75bfff"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>

                                                                <Button Width="14" Height="14" Margin="0,0,3,0" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#FF5555">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/delete_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#FF8888"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#0FFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock Text="Showing data 1 to 8 of 16 entries" Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&lt;" Style="{StaticResource PagingBtnStyle}"/>
                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding Number}" GroupName="ScreeningPages" Style="{StaticResource PagingNumStyle}" IsChecked="{Binding IsActive, Mode=TwoWay}" Click="PageNumber_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="&gt;" Style="{StaticResource PagingBtnStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Visibility="{Binding IsChecked, ElementName=SubTickets, Converter={StaticResource BoolToVis}}" Background="#0DFFFFFF" CornerRadius="20" Margin="30" Padding="25" BorderBrush="#1FFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ticket Records" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Manage and refund customer tickets" Foreground="#16C098" FontSize="12"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#111" CornerRadius="8" Padding="10,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="10" Margin="0,0,8,0"/>
                                    <TextBox Width="140" BorderThickness="0" Background="Transparent" Foreground="White" VerticalAlignment="Center" FontSize="11" CaretBrush="White" Text="Search ticket ID..."/>
                                </StackPanel>
                            </Border>

                            <Border Background="#111" CornerRadius="8" Padding="8,0" Height="32" Margin="0,0,10,0" BorderBrush="#1FFFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Sort by:" Foreground="#44FFFFFF" VerticalAlignment="Center" FontSize="11" Margin="0,0,3,0"/>
                                    <ComboBox Style="{StaticResource CleanComboBox}" Width="70" FontSize="11" FontWeight="DemiBold" Margin="0,-2,0,0">
                                        <ComboBoxItem Content="Latest" IsSelected="True" Foreground="White"/>
                                        <ComboBoxItem Content="Movie" Foreground="White"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1">
                            <Grid Margin="15,0" TextElement.Foreground="#44FFFFFF" TextElement.FontSize="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ID" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Customer" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="Movie Title" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="Date &amp; Time" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="4" Text="Seat" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="5" Text="Status" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="6" Text="Manage" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AllTickets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="AdminTicketSelection" Cursor="Hand">
                                            <RadioButton.Template>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="RowBorder" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" Padding="15,10" Background="Transparent">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="40"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="2*"/>
                                                                <ColumnDefinition Width="1.5*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="1*"/>
                                                                <ColumnDefinition Width="85"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Id}" Foreground="#66FFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1" Text="{Binding CustomerName}" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0,10,0"/>

                                                            <TextBlock Grid.Column="3" Text="{Binding SessionTime}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="4" Text="{Binding SeatInfo}" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center"/>

                                                            <Border Grid.Column="5" Background="#1A00B087" CornerRadius="6" VerticalAlignment="Center" Padding="8,2" HorizontalAlignment="Left">
                                                                <TextBlock Text="Valid" Foreground="#16C098" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            </Border>

                                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                <Button Width="14" Height="14" Margin="0,0,3,0" Cursor="Hand" Background="Transparent" BorderThickness="0" ToolTip="Refund Ticket">
                                                                    <Button.Template>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="iconColor" Background="#FF5555">
                                                                                <Border.OpacityMask>
                                                                                    <ImageBrush ImageSource="/Resources/Icons/delete_icon.png" Stretch="Uniform"/>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="iconColor" Property="Background" Value="#FF8888"/>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Button.Template>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#1AFFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background" Value="#0FFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </RadioButton.Template>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock Text="Showing data 1 to 8 of 16 entries" Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="&lt;" Style="{StaticResource PagingBtnStyle}"/>
                            <ItemsControl ItemsSource="{Binding PageNumbers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Content="{Binding}" GroupName="Pages" Style="{StaticResource PagingNumStyle}" IsChecked="{Binding IsActive, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="&gt;" Style="{StaticResource PagingBtnStyle}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
