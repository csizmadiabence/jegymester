<UserControl x:Class="ticketmasterwpf.Views.MovieCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Background="Transparent">

    <UserControl.Resources>
        <Storyboard x:Key="ListRefreshAnimation">
            <DoubleAnimation Storyboard.TargetName="MoviesItemsControl" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.4"/>
        </Storyboard>

        <Style x:Key="MyCalendarDayButton" TargetType="{x:Type primitives:CalendarDayButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarDayButton}">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="14" Background="#16C098" Opacity="0" Margin="1"/>
                            <ContentPresenter TextElement.Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Bg" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyCalendarButton" TargetType="{x:Type primitives:CalendarButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarButton}">
                        <Border Background="Transparent">
                            <ContentPresenter TextElement.Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyCalendarItem" TargetType="{x:Type primitives:CalendarItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:CalendarItem}">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Foreground="#A0A5B5" FontWeight="Bold" FontSize="11" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6" Text="{Binding}"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>

                        <Grid x:Name="PART_Root">
                            <Border Background="Transparent" BorderThickness="0">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Button x:Name="PART_PreviousButton" Grid.Row="0" Grid.Column="0" Content="&lt;" Width="30" Height="30" FontSize="14" FontWeight="Bold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter TextElement.Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="PART_HeaderButton" Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="14" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter TextElement.Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="PART_NextButton" Grid.Row="0" Grid.Column="2" Content="&gt;" Width="30" Height="30" FontSize="14" FontWeight="Bold" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter TextElement.Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Visible" Margin="0,10,0,0"/>
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Visibility="Hidden" Margin="0,10,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MyDarkCalendar" TargetType="Calendar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource MyCalendarDayButton}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource MyCalendarButton}"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource MyCalendarItem}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="320"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,12,30,5" MinHeight="42">
            <Grid x:Name="NowShowingHeader" Visibility="Visible">
                <TextBlock Text="NOW SHOWING" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>

                <Border HorizontalAlignment="Right" Background="#1AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="4,2">
                    <StackPanel Orientation="Horizontal">

                        <ItemsControl ItemsSource="{Binding AvailableDates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="DateSelector" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="DateBtn_Click" Margin="1,0" Cursor="Hand">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Grid>
                                                    <Border x:Name="GlowBorder" CornerRadius="10" BorderThickness="1.5" Opacity="0">
                                                        <Border.BorderBrush>
                                                            <SolidColorBrush Color="#16C098"/>
                                                        </Border.BorderBrush>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#16C098" BlurRadius="12" ShadowDepth="0" Opacity="0.4" RenderingBias="Quality"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border x:Name="DateBorder" CornerRadius="10" Background="Transparent" Padding="7,4" MinWidth="55" BorderThickness="1" BorderBrush="Transparent">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="DayTxt" Text="{Binding DayName}" Foreground="#66A0A5B5" FontSize="7.5" HorizontalAlignment="Center"/>
                                                            <TextBlock x:Name="DateTxt" Text="{Binding DateNumber}" Foreground="#A0A5B5" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="DateBorder" Property="Background" Value="#1AFFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="GlowBorder" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="DateBorder" Property="Background" Value="#26FFFFFF"/>
                                                        <Setter TargetName="DayTxt" Property="Foreground" Value="#CC16C098"/>
                                                        <Setter TargetName="DateTxt" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Rectangle Width="1" Fill="#1FFFFFFF" Margin="5,4" Height="20"/>

                        <ToggleButton x:Name="CalendarDropDownBtn" Background="Transparent" BorderThickness="0" Width="35" Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="Transparent">
                                        <TextBlock Text="📅" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{TemplateBinding Foreground}" x:Name="Icon"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Icon" Property="Foreground" Value="#16C098"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup IsOpen="{Binding IsChecked, ElementName=CalendarDropDownBtn}" StaysOpen="False" PlacementTarget="{Binding ElementName=CalendarDropDownBtn}" Placement="Bottom" HorizontalOffset="-140" AllowsTransparency="True">

                            <Border Background="#1A1A1C" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,5,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.7" Color="Black"/>
                                </Border.Effect>

                                <Calendar x:Name="InlineCalendar" Style="{StaticResource MyDarkCalendar}" Width="230" Height="250" SelectedDatesChanged="InlineCalendar_SelectedDatesChanged" DisplayDateStart="{Binding Mode=OneWay, Source={x:Static sys:DateTime.Today}}"/>
                            </Border>
                        </Popup>

                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="SoonHeader" Visibility="Collapsed">
                <TextBlock Text="UPCOMING RELEASES" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" x:Name="MovieListView" ClipToBounds="False">
            <ScrollViewer x:Name="MoviesScrollViewer" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalAlignment="Top" ClipToBounds="False">
                <ItemsControl x:Name="MoviesItemsControl" Margin="20,5,20,5" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="173" Height="260" Margin="15" CornerRadius="15" Cursor="Hand" BorderBrush="#3FFFFFFF" BorderThickness="1" Background="Transparent" MouseLeftButtonDown="MovieCard_Click">
                                <Grid>
                                    <Border CornerRadius="15">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding PosterUrl, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <Border CornerRadius="15">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.5"/>
                                                <GradientStop Color="#CC000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <StackPanel VerticalAlignment="Bottom" Margin="15">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="★ " Foreground="Gold" FontSize="10"/>
                                            <TextBlock Text="{Binding ImdbRating}" Foreground="#CCFFFFFF" FontSize="10"/>
                                            <TextBlock Text="  •  Movie" Foreground="#CCFFFFFF" FontSize="10"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Width="40" HorizontalAlignment="Left" VerticalAlignment="Stretch" Cursor="Hand" Click="ScrollLeft_Click" Opacity="0.15">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path Data="M 25,10 L 10,25 L 25,40" Stroke="White" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Width="40" HorizontalAlignment="Right" VerticalAlignment="Stretch" Cursor="Hand" Click="ScrollRight_Click" Opacity="0.15">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Path Data="M 10,10 L 25,25 L 10,40" Stroke="White" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>