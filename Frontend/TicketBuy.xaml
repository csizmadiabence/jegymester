<Page x:Class="ticketmasterwpf.TicketBuy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ticketmasterwpf"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="950"
      Title="GuestPage">

    <Page.Resources>
        <Style TargetType="ToggleButton" x:Key="SeatStyle">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4,4,2,2">
                            <Grid>
                                <TextBlock Text="{Binding Number}" Foreground="White" FontSize="12" 
                                           FontWeight="Bold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <Rectangle Height="2" Fill="White" Opacity="0.5" VerticalAlignment="Bottom" Margin="4,0,4,3"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                    <Setter Property="Background" Value="#8F9AA3"/>
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#385399"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="PremiumEntranceAnimation">
            <DoubleAnimation Storyboard.TargetName="ManageStackPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1" BeginTime="0:0:0.3"/>
            <DoubleAnimation Storyboard.TargetName="ManageStackPanelTransform" Storyboard.TargetProperty="Y" From="-20" To="0" Duration="0:0:1.2" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard Storyboard="{StaticResource PremiumEntranceAnimation}"/>
        </EventTrigger>
    </Page.Triggers>

    <Grid>

        <Grid Margin="10,5,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,30,0,10">
                <Path Data="M 0,15 Q 150,0 300,15 L 280,20 Q 150,5 20,20 Z" Fill="#E0E0E0" Stretch="Fill" Width="360" Height="20"/>
                <TextBlock Text="1. terem" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="White" FontSize="12"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding TheaterRows}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding RowNumber}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                           FontWeight="Bold" Foreground="#888" FontSize="14"/>

                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Seats}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource SeatStyle}" 
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Click="Seat_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Column="2" Text="{Binding RowNumber}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                           FontWeight="Bold" Foreground="#888" FontSize="14"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="0,5,0,0">
                <TextBlock Text="You can book a maximum of 10 seats per transaction." FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="White"/>
                <TextBlock Text="Please do not leave an empty seat between selected seats." HorizontalAlignment="Center" Foreground="#AAA" FontSize="11"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                    <Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,5,0"/>
                    <TextBlock Text="Available" Margin="0,0,15,0" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    <Ellipse Width="10" Height="10" Fill="#385399" Margin="0,0,5,0"/>
                    <TextBlock Text="Selected" Margin="0,0,15,0" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    <Ellipse Width="10" Height="10" Fill="#8F9AA3" Margin="0,0,5,0"/>
                    <TextBlock Text="Occupied" FontWeight="Bold" FontSize="11" Foreground="White"/>
                </StackPanel>

                <Grid Margin="0,0,0,0" Width="915">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="10,0,0,5">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="🎫" Foreground="#D99058" FontSize="16" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TicketCountText" Text="0" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                        </StackPanel>
                        <Button x:Name="CancelButton" Content="CANCEL" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Foreground="White" BorderThickness="1.5" BorderBrush="#D99058" Padding="15,6" FontSize="10" FontWeight="Bold" Click="CancelButton_Click" Margin="-5,0,0,25" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock x:Name="SelectedSeatsText" Canvas.Bottom="40" Canvas.Right="0" Foreground="#DDD" FontWeight="Bold" FontSize="11" TextAlignment="Right" Visibility="Collapsed" LineHeight="16" Margin="0,0,0,25"/>
                        </Canvas>

                        <Button x:Name="ConfirmButton" Content="CONFIRM SEATS" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Foreground="White" BorderThickness="1.5" BorderBrush="#D99058" Padding="15,6" FontSize="10" FontWeight="Bold" Click="ConfirmButton_Click" Margin="0,0,0,30" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="ManageStackPanel" Opacity="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="50">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="ManageStackPanelTransform" Y="40"/>
            </StackPanel.RenderTransform>
            <StackPanel.Resources>
                <Style TargetType="Button" x:Key="WindowControlBtnStyle">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Width" Value="13"/>
                    <Setter Property="Height" Value="13"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="HoverBorder" Background="#22FFFFFF" CornerRadius="5" Opacity="0"/>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <Button Style="{StaticResource WindowControlBtnStyle}" Click="Exit_Click">
                <Image Source="/Resources/Icons/exit_icon.png" Width="10" Height="10"/>
            </Button>
            <Button Style="{StaticResource WindowControlBtnStyle}" Click="Minimize_Click">
                <Image Source="/Resources/Icons/minimize_icon.png" Width="10" Height="10"/>
            </Button>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,30,0" Panel.ZIndex="40">
            <TextBlock Text="{Binding SelectedMovieTitle}" 
               Foreground="#FFFFFF" 
               FontSize="13" 
               FontWeight="Bold" 
               TextAlignment="Right" 
               Opacity="0.9"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                <TextBlock Text="{Binding SelectedShowtime}" 
                   Foreground="#FFFFFF" 
                   FontSize="11" 
                   FontWeight="Regular"/>
            </StackPanel>
        </StackPanel>

        <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,15,0" Panel.ZIndex="50">
            <Border x:Name="ErrorToast" Background="#2D2D30" CornerRadius="12" Opacity="0" Visibility="Collapsed" HorizontalAlignment="Center" Padding="15,5,15,5" BorderThickness="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,8,0">
                            <Ellipse x:Name="ErrorIconBack" Fill="IndianRed" Visibility="Visible"/>
                            <TextBlock x:Name="ErrorIconText" Text="!" Foreground="White" FontSize="9pt" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                            <Ellipse x:Name="SuccessIconBack" Fill="MediumSeaGreen" Visibility="Collapsed"/>
                            <TextBlock x:Name="SuccessIconText" Text="✓" Foreground="White" FontSize="10pt" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="ErrorText" Foreground="White" FontSize="9pt" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-15,-5">
                        <Path x:Name="BgPathLeft" Stroke="#22CD5C5C" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="BgPathRight" Stroke="#22CD5C5C" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="LeftTimerStroke" Stroke="IndianRed" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="RightTimerStroke" Stroke="IndianRed" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SingleSeatModalOverlay" Background="#AA000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="White" Width="350" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5"/>
                </Border.Effect>

                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="12" LineHeight="18" TextAlignment="Center"
                               Text="To allow for the maximum occupancy of the cinema hall, please make the selection again without leaving a single seat. Thank you on behalf of other customers."/>

                    <Button x:Name="CloseModal" Content="CANCEL" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Foreground="#D99058" BorderThickness="1.5" BorderBrush="#D99058" Padding="15,6" FontSize="10" FontWeight="Bold" Click="CloseModal_Click" Margin="0,0,115,0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Page>