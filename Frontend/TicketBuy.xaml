<Page x:Class="ticketmasterwpf.TicketBuy"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ticketmasterwpf"
      xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
      xmlns:modals="clr-namespace:ticketmasterwpf.Modals"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="950"
      Title="GuestPage">

	<Page.Resources>
        <Style TargetType="ToggleButton" x:Key="SeatStyle">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="SeatBackrest" Background="{TemplateBinding Background}" CornerRadius="4,4,2,2" Margin="0,0,0,6">
                                <TextBlock x:Name="NumberText" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{TemplateBinding Foreground}"/>
                            </Border>

                            <Border x:Name="SeatCushion" Background="{TemplateBinding Background}" CornerRadius="2" Height="4" VerticalAlignment="Bottom" Margin="2,0,2,0" Opacity="0.8"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Number}" Value="0">
                                <Setter TargetName="NumberText" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SeatBackrest" Property="Background" Value="#385399"/>
                                <Setter TargetName="SeatCushion" Property="Background" Value="#385399"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding IsOccupied}" Value="True">
                                <Setter TargetName="SeatBackrest" Property="Background" Value="#555555"/>
                                <Setter TargetName="SeatCushion" Property="Background" Value="#444444"/>
                                <Setter TargetName="NumberText" Property="Foreground" Value="#888888"/>
                                <Setter Property="IsEnabled" Value="False"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </DataTrigger>

                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding IsOccupied}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SeatBackrest" Property="Background" Value="#66BB6A"/>
                                <Setter TargetName="SeatCushion" Property="Background" Value="#66BB6A"/>
                            </MultiDataTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlowButtonStyle" TargetType="Button">
			<Setter Property="Height" Value="28"/>
			<Setter Property="FontSize" Value="9"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border x:Name="glowLayer" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Background="Transparent" Opacity="0"/>
							<Border x:Name="mainBorder" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Background="Transparent">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
							</Border>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="glowLayer" Property="Opacity" Value="1"/>
								<Setter TargetName="glowLayer" Property="Effect">
									<Setter.Value>
										<DropShadowEffect Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" BlurRadius="15" ShadowDepth="0" Opacity="0.5" RenderingBias="Quality"/>
									</Setter.Value>
								</Setter>
								<Setter TargetName="mainBorder" Property="Background" Value="#1AFFFFFF"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Storyboard x:Key="PremiumEntranceAnimation">
			<DoubleAnimation Storyboard.TargetName="ManageStackPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1" BeginTime="0:0:0.3"/>
			<DoubleAnimation Storyboard.TargetName="ManageStackPanelTransform" Storyboard.TargetProperty="Y" From="-20" To="0" Duration="0:0:1.2" BeginTime="0:0:0.3">
				<DoubleAnimation.EasingFunction>
					<CubicEase EasingMode="EaseOut"/>
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
		</Storyboard>
	</Page.Resources>

	<Page.Triggers>
		<EventTrigger RoutedEvent="Page.Loaded">
			<BeginStoryboard Storyboard="{StaticResource PremiumEntranceAnimation}"/>
		</EventTrigger>
	</Page.Triggers>

	<Grid>

		<Grid Margin="10,5,10,5">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,30,0,10">
				<Path Data="M 0,15 Q 150,0 300,15 L 280,20 Q 150,5 20,20 Z" Fill="#E0E0E0" Stretch="Fill" Width="360" Height="20"/>
                <TextBlock Text="{Binding SelectedRoomName}" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="White" FontSize="12"/>
			</StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="850" Margin="20">
                    <ItemsControl ItemsSource="{Binding TheaterRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding RowNumber}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#66FFFFFF" FontSize="16" FontWeight="Bold"/>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Seats}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="{Binding DataContext.MaxColumns, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource SeatStyle}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="Seat_Click" Width="34" Height="34" Margin="2.5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Grid.Column="2" Text="{Binding RowNumber}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#66FFFFFF" FontSize="16" FontWeight="Bold"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Viewbox>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="0,5,0,0">
				<TextBlock Text="You can book a maximum of 10 seats per transaction." FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="White"/>
				<TextBlock Text="Please do not leave an empty seat between selected seats." HorizontalAlignment="Center" Foreground="#AAA" FontSize="11"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
					<Ellipse Width="10" Height="10" Fill="#4CAF50" Margin="0,0,5,0"/>
					<TextBlock Text="Available" Margin="0,0,15,0" FontWeight="Bold" FontSize="11" Foreground="White"/>
					<Ellipse Width="10" Height="10" Fill="#385399" Margin="0,0,5,0"/>
					<TextBlock Text="Selected" Margin="0,0,15,0" FontWeight="Bold" FontSize="11" Foreground="White"/>
					<Ellipse Width="10" Height="10" Fill="#8F9AA3" Margin="0,0,5,0"/>
					<TextBlock Text="Occupied" FontWeight="Bold" FontSize="11" Foreground="White"/>
				</StackPanel>

				<Grid Margin="0,0,0,0" Width="915">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="10,0,0,5">
						<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
							<TextBlock Text="🎫" Foreground="#FFDDDDDD" FontSize="16" Margin="0,0,5,0"/>
							<TextBlock x:Name="TicketCountText" Text="0" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
						</StackPanel>
						<Button x:Name="CancelButton" Content="CANCEL" Click="CancelButton_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#FFFF5555" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Margin="-5,0,0,25" Width="70" Height="25"/>
					</StackPanel>

					<Grid Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
						<Canvas Width="0" Height="0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
							<TextBlock x:Name="SelectedSeatsText" Canvas.Bottom="40" Canvas.Right="0" Foreground="#DDD" FontWeight="Bold" FontSize="11" TextAlignment="Right" Visibility="Collapsed" LineHeight="16" Margin="0,0,0,25"/>
						</Canvas>

						<Button x:Name="ConfirmButton" Content="CONFIRM SEATS" Click="ConfirmButton_Click" Style="{StaticResource GlowButtonStyle}" BorderBrush="#16C098" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="Hand" Margin="0,0,0,30" Width="100" Height="25"/>
					</Grid>
				</Grid>
			</StackPanel>
		</Grid>
		<StackPanel x:Name="ManageStackPanel" Opacity="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0" Panel.ZIndex="50">
			<StackPanel.RenderTransform>
				<TranslateTransform x:Name="ManageStackPanelTransform" Y="40"/>
			</StackPanel.RenderTransform>
			<StackPanel.Resources>
				<Style TargetType="Button" x:Key="WindowControlBtnStyle">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="Width" Value="13"/>
					<Setter Property="Height" Value="13"/>
					<Setter Property="Cursor" Value="Hand"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Border x:Name="HoverBorder" Background="#22FFFFFF" CornerRadius="5" Opacity="0"/>
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</StackPanel.Resources>
			<Button Style="{StaticResource WindowControlBtnStyle}" Click="Exit_Click">
				<Image Source="/Resources/Icons/exit_icon.png" Width="10" Height="10"/>
			</Button>
			<Button Style="{StaticResource WindowControlBtnStyle}" Click="Minimize_Click">
				<Image Source="/Resources/Icons/minimize_icon.png" Width="10" Height="10"/>
			</Button>
		</StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,30,0" Panel.ZIndex="40">
            <TextBlock Text="{Binding SelectedMovieTitle}" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold" TextAlignment="Right" Opacity="0.9"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                <TextBlock Text="{Binding SelectedShowtime}" Foreground="#FFFFFF" FontSize="11" FontWeight="Regular"/>
            </StackPanel>
        </StackPanel>
        <modals:SingleSeatModal x:Name="SingleSeatPopup" Visibility="Collapsed" Panel.ZIndex="9999" Grid.RowSpan="10" Grid.ColumnSpan="10"/>
        <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Panel.ZIndex="5000"/>
    </Grid>
</Page>