<Page x:Class="ticketmasterwpf.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ticketmasterwpf"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      xmlns:controls="clr-namespace:ticketmasterwpf.Controls"
      mc:Ignorable="d"
      d:DesignHeight="550" d:DesignWidth="950"
      Title="RegisterPage"
      Background="Transparent">

	<Page.Resources>
		<LinearGradientBrush x:Key="SplashPremiumBrush" StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#A0A5B5" Offset="0.0"/>
			<GradientStop Color="#FFFFFF" Offset="0.5"/>
			<GradientStop Color="#606575" Offset="1.0"/>
		</LinearGradientBrush>

		<DropShadowEffect x:Key="SplashSubtleGlow" Color="#A0A5B5" BlurRadius="15" ShadowDepth="0" Opacity="0.6"/>

		<Style x:Key="ConcentricFocusBorderStyle" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="CornerRadius" Value="5"/>

			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="Transparent"/>

			<Style.Triggers>
				<Trigger Property="IsKeyboardFocusWithin" Value="True">
					<Setter Property="BorderBrush" Value="DodgerBlue"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Storyboard x:Key="PremiumEntranceAnimation">
			<DoubleAnimation Storyboard.TargetName="RegisterStackPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1"/>
			<DoubleAnimation Storyboard.TargetName="RegisterStackPanelTransform" Storyboard.TargetProperty="Y" From="40" To="0" Duration="0:0:1.5">
				<DoubleAnimation.EasingFunction>
					<CubicEase EasingMode="EaseOut"/>
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="LogoItemsControl" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
			<DoubleAnimation Storyboard.TargetName="LogoTransform" Storyboard.TargetProperty="Y" From="20" To="0" Duration="0:0:1">
				<DoubleAnimation.EasingFunction>
					<CubicEase EasingMode="EaseOut"/>
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="ManageStackPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:1" BeginTime="0:0:0.3"/>
			<DoubleAnimation Storyboard.TargetName="ManageStackPanelTransform" Storyboard.TargetProperty="Y" From="-20" To="0" Duration="0:0:1.2" BeginTime="0:0:0.3">
				<DoubleAnimation.EasingFunction>
					<CubicEase EasingMode="EaseOut"/>
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
		</Storyboard>
	</Page.Resources>

	<Page.Triggers>
		<EventTrigger RoutedEvent="Page.Loaded">
			<BeginStoryboard Storyboard="{StaticResource PremiumEntranceAnimation}"/>
		</EventTrigger>
	</Page.Triggers>

	<Grid>
		<StackPanel x:Name="RegisterStackPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="418" Height="478">
			<StackPanel.RenderTransform>
				<TranslateTransform x:Name="RegisterStackPanelTransform" Y="40"/>
			</StackPanel.RenderTransform>

			<ItemsControl x:Name="LogoItemsControl" HorizontalAlignment="Center" Margin="0,20,0,15" IsHitTestVisible="False">
				<ItemsControl.ItemsSource>
					<x:Array Type="{x:Type sys:String}">
						<sys:String>t</sys:String>
						<sys:String>i</sys:String>
						<sys:String>c</sys:String>
						<sys:String>k</sys:String>
						<sys:String>e</sys:String>
						<sys:String>t</sys:String>
						<sys:String>m</sys:String>
						<sys:String>a</sys:String>
						<sys:String>s</sys:String>
						<sys:String>t</sys:String>
						<sys:String>e</sys:String>
						<sys:String>r</sys:String>
					</x:Array>
				</ItemsControl.ItemsSource>

				<ItemsControl.RenderTransform>
					<TranslateTransform x:Name="LogoTransform" Y="20"/>
				</ItemsControl.RenderTransform>

				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>

				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding}" FontSize="40" FontFamily="Resources/Assets/#Calistoga" FontWeight="Bold" Foreground="{StaticResource SplashPremiumBrush}" Effect="{StaticResource SplashSubtleGlow}" Margin="0,0,-6,0" />
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>

			<TextBlock Text="Create an account" FontSize="14pt" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
			<TextBlock Text="Enter your details to sign up for this app" FontSize="11pt" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,0,0,20"/>
			<Border x:Name="NameBorder" ToolTip="Please enter your name!" Style="{StaticResource ConcentricFocusBorderStyle}" Height="28" Width="275">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Image Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Margin="8,0,0,0" Source="/Resources/Icons/user_icon.png"/>

					<TextBox Grid.Column="1" x:Name="NameInput" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center" Text=""/>
				</Grid>
			</Border>
			<Border x:Name="EmailBorder" ToolTip="Example: name@domain.com" Style="{StaticResource ConcentricFocusBorderStyle}" Height="28" Width="275" Margin="0,15,0,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Image Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="14" Margin="8,0,0,0" Source="/Resources/Icons/mail_icon.png"/>

					<TextBox Grid.Column="1" x:Name="EmailInput" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center" Text=""/>
				</Grid>
			</Border>
            <Border x:Name="PhoneBorder" ToolTip="Please enter your phone number (e.g., 301234567)" Style="{StaticResource ConcentricFocusBorderStyle}" Height="28" Width="275" Margin="0,15,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="14" Margin="8,0,0,0" Source="/Resources/Icons/phone_icon.png"/>

                    <ComboBox x:Name="PhonePrefixCombo" Grid.Column="1" Style="{StaticResource LightCleanComboBox}" ItemContainerStyle="{StaticResource LightComboBoxItem}" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                        <ComboBoxItem Content="+36 (HU)" Tag="+36" IsSelected="True"/>
                        <ComboBoxItem Content="+43 (AT)" Tag="+43"/>
                        <ComboBoxItem Content="+49 (DE)" Tag="+49"/>
                        <ComboBoxItem Content="+44 (UK)" Tag="+44"/>
                        <ComboBoxItem Content="+40 (RO)" Tag="+40"/>
                        <ComboBoxItem Content="+421 (SK)" Tag="+421"/>
                        <ComboBoxItem Content="+1 (US)" Tag="+1"/>
                        <ComboBoxItem Content="+" Tag="+"/>
                    </ComboBox>

                    <TextBox Grid.Column="2" x:Name="PhoneInput" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center" Text="" MaxLength="15"/>
                </Grid>
            </Border>
            <Border x:Name="PasswordBorder" ToolTip="Min. 6 characters, 1 uppercase letter and 1 special character (e.g., !@#$)" Style="{StaticResource ConcentricFocusBorderStyle}" Height="28" Width="275" Margin="0,15,0,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Image Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="14" Margin="8,0,0,0" Source="/Resources/Icons/lock_icon.png"/>

					<PasswordBox Grid.Column="1" x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center"/>

					<TextBox Grid.Column="1" x:Name="PasswordVisibleInput" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center"/>

					<Button Grid.Column="2" x:Name="TogglePasswordButton" Visibility="Collapsed" PreviewMouseLeftButtonDown="TogglePasswordButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="TogglePasswordButton_PreviewMouseLeftButtonUp" MouseLeave="TogglePasswordButton_MouseLeave" Background="Transparent" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
						<Image Source="/Resources/Icons/eye_icon.png" Height="10" Width="10"/>
					</Button>
				</Grid>
			</Border>
			<Border x:Name="PasswordConfirmBorder" ToolTip="The two passwords must match!" Style="{StaticResource ConcentricFocusBorderStyle}" Height="28" Width="275" Margin="0,15,0,0">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<Image Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="14" Width="14" Margin="8,0,0,0" Source="/Resources/Icons/lock_icon.png"/>

					<PasswordBox Grid.Column="1" x:Name="PasswordConfirmInput" PasswordChanged="PasswordConfirmInput_PasswordChanged" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center"/>

					<TextBox Grid.Column="1" x:Name="PasswordConfirmVisibleInput" Visibility="Collapsed" IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="5,0,5,0" FontSize="11pt" Foreground="Black" VerticalContentAlignment="Center"/>

					<Button Grid.Column="2" x:Name="TogglePasswordConfirmButton" Visibility="Collapsed" PreviewMouseLeftButtonDown="TogglePasswordConfirmButton_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="TogglePasswordConfirmButton_PreviewMouseLeftButtonUp" MouseLeave="TogglePasswordConfirmButton_MouseLeave" Background="Transparent" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand">
						<Image Source="/Resources/Icons/eye_icon.png" Height="10" Width="10"/>
					</Button>
				</Grid>
			</Border>

            <Button Content="Register" Click="RegisterButton_Click" Background="#D99058" Foreground="White" Height="28" Width="275" Margin="0,15,0,15" FontSize="9pt" Cursor="Hand">
                <Button.Style>
					<Style TargetType="Button">
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="Button">
                                    <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="5" BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="btnBorder" Property="Background" Value="#D99958"/>
										</Trigger>
										<Trigger Property="IsPressed" Value="True">
											<Setter TargetName="btnBorder" Property="Background" Value="#D99358"/>
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</Button.Style>
			</Button>
			<Grid Width="275">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Separator Background="#444" VerticalAlignment="Center" Margin="0,0,10,0"/>

				<Button Grid.Column="1" Content="Already have an account? Sign in" Click="GoToLogin_Click" Foreground="#A0A0A0" FontSize="9pt" Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="{x:Type Button}">
							<TextBlock Text="{TemplateBinding Content}" Background="Transparent">
								<TextBlock.Style>
									<Style TargetType="{x:Type TextBlock}">
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Foreground" Value="#A0A0A0"/>
												<Setter Property="TextDecorations" Value="Underline"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</ControlTemplate>
					</Button.Template>
				</Button>

				<Separator Grid.Column="2" Background="#444" VerticalAlignment="Center" Margin="10,0,0,0"/>
			</Grid>

			<Grid Width="235">
				<TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="7pt" Foreground="#777" Margin="0,10,0,0">
					By clicking continue, you agree to our <Span Foreground="White">Terms of Service</Span> and <Span Foreground="White">Privacy Policy</Span>
				</TextBlock>
			</Grid>
		</StackPanel>
		<StackPanel x:Name="ManageStackPanel" Opacity="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
			<StackPanel.RenderTransform>
				<TranslateTransform x:Name="ManageStackPanelTransform" Y="40"/>
			</StackPanel.RenderTransform>
			<StackPanel.Resources>
				<Style TargetType="Button" x:Key="WindowControlBtnStyle">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderThickness" Value="0"/>
					<Setter Property="Width" Value="13"/>
					<Setter Property="Height" Value="13"/>
					<Setter Property="Cursor" Value="Hand"/>
					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="Button">
								<Grid>
									<Border x:Name="HoverBorder" Background="#22FFFFFF" CornerRadius="5" Opacity="0"/>
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Grid>
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Trigger.EnterActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
												</Storyboard>
											</BeginStoryboard>
										</Trigger.EnterActions>
										<Trigger.ExitActions>
											<BeginStoryboard>
												<Storyboard>
													<DoubleAnimation Storyboard.TargetName="HoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
												</Storyboard>
											</BeginStoryboard>
										</Trigger.ExitActions>
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</StackPanel.Resources>

			<Button Style="{StaticResource WindowControlBtnStyle}" Click="Exit_Click">
				<Image Source="/Resources/Icons/exit_icon.png" Width="10" Height="10"/>
			</Button>
			<Button Style="{StaticResource WindowControlBtnStyle}" Click="Minimize_Click">
				<Image Source="/Resources/Icons/minimize_icon.png" Width="10" Height="10"/>
			</Button>
		</StackPanel>
        <controls:ToastControl x:Name="AppToast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Panel.ZIndex="5000" Grid.RowSpan="5"/>
    </Grid>
</Page>
